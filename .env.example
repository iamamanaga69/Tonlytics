# =========================================================================
# TONLYTICS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local (in apps/web) or set on Vercel deployment
# =========================================================================

# 1. Supabase Connection (Public client settings)
# Required for front-end reads and real-time updates
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Administrative Key (Service Role)
# Required for secure write operations in backend cron API routes (bypasses RLS)
# WARNING: NEVER expose this key to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Database URL (Optional: only needed if using Drizzle ORM migration scripts)
DATABASE_URL=postgres://postgres:password@db.your-project-id.supabase.co:6543/postgres

# 4. Telegram Bot Integration (Optional: for auto-broadcasting briefings to channels)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# 5. AI Integration (Optional: Google Gemini API)
# If unconfigured, Tonlytics falls back gracefully to local rule-based mock summarization
GEMINI_API_KEY=AIzaSy...

# 6. API Cron Security (Required)
# Prevents unauthorized public execution of crawling and ingestion endpoints
# Trigger routes via: GET /api/cron/ingest?secret=YOUR_CRON_SECRET
CRON_SECRET=dev_secret_token
